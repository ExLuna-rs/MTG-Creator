{
  "name": "mtg-creator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm ocr:assets && next dev",
    "build": "pnpm ocr:assets && next build",
    "build:scripts": "node scripts/bundle.mts",
    "start": "next start",
    "lint": "biome check",
    "ocr:assets": "node scripts/copy-ocr-assets.mts",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mts",
    "cards:sync": "pnpm build:scripts && node dist/scripts/sync-cards.mjs",
    "cards:seed": "pnpm build:scripts && node dist/scripts/sync-cards.mjs --file tests/fixtures/cards.jsonl",
    "fixtures:cards": "esbuild scripts/build-card-fixture.mts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/build-card-fixture.mjs && node dist/build-card-fixture.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@techstark/opencv-js": "4.12.0-release.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.52.0",
    "mana-font": "1.18.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "7.0.0",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
