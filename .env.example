# Configuration locale de l'environnement Docker de développement.
# `make dev` copie ce fichier en .env s'il n'existe pas ; toutes les valeurs
# ont un défaut, ce fichier sert seulement à les personnaliser.
# Ne mettez jamais de vrais secrets dans .env.example.

# Base de données PostgreSQL (service db)
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg
POSTGRES_DB=mtg

# Utilisateur des conteneurs de développement. Le Makefile le renseigne
# automatiquement ; à définir seulement si vous lancez `docker compose`
# directement avec un autre UID que 1000 (commande `id -u`).
# HOST_UID=1000
# HOST_GID=1000

# Ports ouverts sur la machine (accessibles uniquement depuis localhost)
APP_PORT=3000
DB_PORT=5432
MAILPIT_PORT=8025

# Comptes : clé de signature des sessions. La valeur par défaut de
# compose.yaml suffit en développement ; en production, générez-en une avec
# `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=
# Adresse du site, utilisée dans les liens des emails.
# BETTER_AUTH_URL=http://localhost:3000

# Connexion avec Google (facultative). Identifiants d'un « ID client OAuth »
# de type « Application Web » créé dans la console Google Cloud, avec l'URI de
# redirection http://localhost:3000/api/auth/callback/google (voir README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
